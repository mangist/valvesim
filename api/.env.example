# Valvesim API configuration — copy to .env and adjust

# Server
PORT=3001
HOST=0.0.0.0

# PostgreSQL 16+
PGHOST=localhost
PGPORT=5432
PGDATABASE=valvesim
PGUSER=valvesim
PGPASSWORD=changeme

# Or a single connection string (takes precedence when set)
# DATABASE_URL=postgres://valvesim:changeme@localhost:5432/valvesim
